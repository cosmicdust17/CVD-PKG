{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hfkg.local/schema/graph/1.0",
  "title": "三文献统一中文短ID三元组",
  "type": "object",
  "required": [
    "metadata",
    "entities",
    "relations",
    "evidence",
    "triples"
  ],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "schema_version",
        "extractor",
        "document_id"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "extractor": {
          "const": "RAGFlow"
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "reviewed",
            "evidence_checked",
            "pending_review"
          ]
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "document_id",
              "name",
              "sha256"
            ],
            "properties": {
              "document_id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-fA-F0-9]{64}$"
              }
            }
          }
        }
      },
      "additionalProperties": true
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "triples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "target",
          "source_id",
          "target_id",
          "source_name",
          "target_name",
          "source_type",
          "target_type",
          "type",
          "relation",
          "directed",
          "qualifiers",
          "evidence",
          "evidence_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "source_name": {
            "type": "string",
            "minLength": 1
          },
          "target_name": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "enum": [
              "危险因素",
              "心血管疾病",
              "健康指标",
              "人群"
            ]
          },
          "target_type": {
            "enum": [
              "危险因素",
              "心血管疾病",
              "健康指标",
              "人群"
            ]
          },
          "type": {
            "enum": [
              "增加风险",
              "导致",
              "相关"
            ]
          },
          "relation": {
            "enum": [
              "增加风险",
              "导致",
              "相关"
            ]
          },
          "directed": {
            "type": "boolean"
          },
          "qualifiers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/evidence"
            }
          },
          "evidence_ids": {
            "$ref": "#/$defs/evidence_ids"
          },
          "evidence_contexts": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "source_candidate_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "entity": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type",
        "aliases",
        "evidence_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "危险因素",
            "心血管疾病",
            "健康指标",
            "人群"
          ]
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidence_ids"
        }
      }
    },
    "relation": {
      "type": "object",
      "required": [
        "id",
        "source",
        "target",
        "type",
        "evidence_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "增加风险",
            "导致",
            "相关"
          ]
        },
        "directed": {
          "type": "boolean"
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidence_ids"
        },
        "qualifiers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence_contexts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "source_candidate_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "id",
        "document_id",
        "page",
        "quote"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "quote": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    }
  }
}