# Set these variables in the PowerShell session running uvicorn.
LLM_ENABLED=1
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:4b
LLM_TEMPERATURE=0.2
LLM_TIMEOUT=120
LLM_CONTEXT=4096
LLM_KEEP_ALIVE=5m
RAGFLOW_BASE_URL=http://127.0.0.1:19380
RAGFLOW_DATASET_IDS=
RAGFLOW_API_KEY=
RAGFLOW_TIMEOUT=12
HF_LOCAL_EVIDENCE=1
# Default database: data/health-history.sqlite3
# HF_HISTORY_DB=
# Vite proxy override:
# HF_API_TARGET=http://127.0.0.1:8088
